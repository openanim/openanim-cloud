{
  "name": "openanim-cloud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "dev:web": "turbo dev --filter=@openanim/web",
    "dev:api": "turbo dev --filter=@openanim/api",
    "build:web": "turbo build --filter=@openanim/web",
    "build:api": "turbo build --filter=@openanim/api"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^6.0.3"
  }
}
